# ── Required ────────────────────────────────────────────────────────────────
# Admin credentials (created on first start)
CLOUD_ADMIN_USER=admin
CLOUD_ADMIN_PASS=your-strong-password-here

# JWT signing secret. Generate with: openssl rand -hex 32
# IMPORTANT: Set a fixed value so sessions survive restarts.
CLOUD_JWT_SECRET=replace-with-openssl-rand-hex-32-output

# ── Optional ────────────────────────────────────────────────────────────────
# CORS origin - set to your domain in production
CLOUD_CORS_ORIGIN=https://cloud.example.com

# Max upload size in MB (default: 500)
CLOUD_MAX_UPLOAD_MB=500

# JWT token validity in hours (default: 24)
CLOUD_JWT_EXPIRY_HOURS=24

# ── Docker only ─────────────────────────────────────────────────────────────
# The cloud service listens on :8080 by default.
# For Railway or other PaaS that inject $PORT, use CLOUD_ADDR=:$PORT.
# CLOUD_ADDR=:8080
